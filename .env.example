# Database Configuration
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/library_db

# Security
JWT_SECRET=SUPER_SECRET_JWT_KEY_987654321_LIBRARY_SYSTEM_2026
JWT_EXPIRATION=86400

# Face Recognition Parameters
FACE_RECOGNITION_THRESHOLD=0.60
ATTENDANCE_COOLDOWN_SECONDS=300
OVERDUE_FINE_PER_DAY=

# Camera & Storage
UPLOAD_DIRECTORY=uploads
CAMERA_ID=
# Set these together only when using a persistent USB/IP camera agent.
CAMERA_NAME=
CAMERA_LOCATION=
CAMERA_INDEX=0
MAIN_API_URL=http://localhost:8000/api

# Password reset: configure SMTP for email delivery. Without SMTP, the local UI
# displays the generated one-time reset link so it can be tested end to end.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Browser monitor uses its authenticated session; this key is only for a standalone camera agent.
FACE_SERVICE_TOKEN=
CAMERA_SOURCE=0
FACE_MATCH_MARGIN=0.08
FACE_CONFIRM_FRAMES=3
ATTENDANCE_TIMEZONE=Asia/Kolkata
